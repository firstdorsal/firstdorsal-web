---
import Layout from '../layouts/Layout.astro'
import SiteHeader from '@/components/SiteHeader.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import MailText from '@/components/MailText.astro'
import { BETREIBER } from '@/lib/betreiber'
---

<Layout
  title="Impressum · firstdorsal"
  description={`Impressum der ${BETREIBER.name}, ${BETREIBER.ort}.`}
>
  <div class="min-h-svh bg-background text-foreground">
    <SiteHeader />

    <main class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
      <p class="label-caps text-brand">Rechtliches</p>
      <h1
        class="mt-4 font-serif text-4xl font-semibold tracking-tight sm:text-5xl"
      >
        Impressum
      </h1>

      <section class="mt-12">
        <h2 class="font-serif text-2xl font-semibold tracking-tight">
          Angaben gemäß § 5 DDG
        </h2>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          {BETREIBER.name}<br />
          Inhaber: {BETREIBER.inhaber}<br />
          {BETREIBER.strasse}<br />
          {BETREIBER.plz} {BETREIBER.ort}<br />
          Deutschland
        </p>
      </section>

      <section class="mt-10">
        <h2 class="font-serif text-2xl font-semibold tracking-tight">
          Kontakt
        </h2>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          E-Mail: <MailText postfach="mail" />
        </p>
      </section>

      <section class="mt-10">
        <h2 class="font-serif text-2xl font-semibold tracking-tight">
          Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV
        </h2>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          {BETREIBER.inhaber} (Anschrift wie oben)
        </p>
      </section>

      <section class="mt-10">
        <h2 class="font-serif text-2xl font-semibold tracking-tight">
          Verbraucherstreitbeilegung
        </h2>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          Wir sind nicht bereit oder verpflichtet, an
          Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle
          teilzunehmen.
        </p>
      </section>
    </main>

    <SiteFooter postfach="mail" />
  </div>
</Layout>
