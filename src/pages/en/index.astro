---
import Layout from '../../layouts/Layout.astro'
import Startseite from '@/components/Startseite.astro'
import { BETREIBER, postanschrift } from '@/lib/betreiber'

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: BETREIBER.name,
  url: 'https://firstdorsal.eu/en/',
  image: 'https://firstdorsal.eu/og.png',
  description:
    'Software development and creative web design, IT forensics with technical expert reports, plus operations & infrastructure – based in Augsburg, Germany.',
  address: postanschrift,
}
---

<Layout
  lang="en"
  title={BETREIBER.name}
  description={`${BETREIBER.name}, Augsburg (Germany) – software development and creative web design, IT forensics with technical expert reports, plus operations & infrastructure.`}
  alternates={{ de: '/', en: '/en/' }}
>
  <Startseite lang="en" postfach="mail" />

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />
</Layout>
